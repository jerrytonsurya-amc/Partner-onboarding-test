# Copy this file to .env and fill in the Digio sandbox values.
# Restart `node serve.js` after changing it.

# sandbox calls https://ext.digio.in:444. Use production only when Digio has enabled it.
DIGIO_ENV=sandbox

# From the Digio dashboard. These stay on the server and are not sent to the browser.
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=

# DigiStudio template name that contains a DigiLocker step for Aadhaar.
# This can be Digio's standard PAN and Aadhaar fetch template, or one you create.
DIGIO_DIGILOCKER_TEMPLATE=
